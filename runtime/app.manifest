<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Manifest of TagForceRecomp.exe: common controls version 6 (buttons, edit boxes and bars in the current Windows style, and the
     dark theme of the controls; without it everything came out in the classic theme) and declared Windows 10/11 compatibility.
     DPI awareness is NOT declared here: the process stays DPI-unaware (the game handles its own window) and the windows
     that need it (launcher, message boxes) turn on DPI awareness per thread. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="TagForceRecomp" version="1.0.0.0" processorArchitecture="*"/>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0" processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
